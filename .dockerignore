# Docker reads .dockerignore from the build context root, which is also where
# the Dockerfile lives.
#
# Two jobs: keep secrets out of the build, and keep the context small. Without
# it, .venv and the 5 MB HAR capture are uploaded to the daemon on every build.

# --- Secrets. These must never reach an image. -----------------------------
# The Dockerfile copies named paths rather than `COPY . .`, so nothing here
# would be picked up anyway -- but a build should not be one edit away from
# baking a private key into a layer.
credentials.json
google-credentials.json
*-credentials.json
*.pem
*.key
.env
.env.*
!.env.example

# --- Captured traffic, which carries session cookies and tokens ------------
*.har
ksp_real.html*
captures/

# --- Local state -----------------------------------------------------------
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
logs/
backups/

# --- Version control and CI ------------------------------------------------
.git/
.gitignore
.github/

# --- Not needed at runtime -------------------------------------------------
# The image holds the API and the sync. It does not need the test suites, the
# captured fixtures (270 KB of catalogue), the one-off tools, or the docs.
tests/
scraper/tests/
scraper/fixtures/
tools/
data/
docs/
apps-script/
*.md
*.xlsx
*.csv

# --- Build files themselves ------------------------------------------------
# Read by the builder via -f, so they do not need to be in the context, and
# there is no reason to ship them inside the image.
Dockerfile
.dockerignore

# --- Editor / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
