# Copy to .env and adjust. .env is gitignored; .env.example is not.
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
SPREADSHEET_ID=1KdcjtNqLkmJo4XYiGM2oX5lo9NjqfDKpGc8HCteFmGk
FLASK_ENV=production
PORT=5000

# --- Nightly price sync (Coolify Scheduled Task) ---------------------------
# All optional for the API; required for the scheduled sync.

# The service account key as one value: the entire contents of the JSON file.
# In Coolify this must be RUNTIME-ONLY -- a build-time variable becomes a
# Dockerfile ARG and the JSON breaks the build.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}

# Email. An app password, never the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# NOTIFY_FROM=you@example.com
# NOTIFY_TO=anat@example.com
# NOTIFY_FAILURE_TO=you@example.com

# Only if the server cannot reach ksp.co.il (403 from Cloudflare).
# Applied to the KSP request alone, not to Google Sheets or SMTP.
# KSP_PROXY_URL=http://user:pass@proxy.example.co.il:8080
